# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env && docker compose up -d

# --- Required --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Agent -----------------------------------------------------------------
# Space-separated names for a fleet; the first one receives remote-platform DMs.
ARC_AGENTS=arc_agent
ARC_AGENT_MODEL=anthropic/claude-sonnet-5
ARC_TIER=personal
ARC_UI_PORT=8420

# --- Telegram (optional) ---------------------------------------------------
# allowed-user-ids is the authorization gate: empty means deny everyone.
ARC_ENABLE_TELEGRAM=0
ARCAGENT_TELEGRAM_BOT_TOKEN=
ARC_TELEGRAM_ALLOWED_USER_IDS=

# --- Online deployment only (deploy/cloud) ---------------------------------
# The hostname Caddy requests a certificate for. Must already resolve to this
# VM's public IP, or the ACME challenge fails.
ARC_DOMAIN=
ARC_ACME_EMAIL=

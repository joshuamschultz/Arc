# Evaluation harnesses. Each eval owns a directory under evaluations/ and
# generates its own data, runs and results. None of that is repo content.
# Every pattern is anchored to a per-eval artifact directory and none covers a
# source directory: git cannot re-include a file beneath an ignored directory,
# so a `!` negation could never rescue harness code that fell under one. Source
# lives at evaluations/<eval>/ and its packages; artifacts live in the three
# generated directories named here.
/evaluations/*/data/
/evaluations/*/runs/
/evaluations/*/results/
# Traces and the audit chain the agent writes inside a run workspace.
/evaluations/**/traces/
/evaluations/**/.audit/
# Generated agent configs, named individually. A blanket `*.toml` would hide 41
# tracked files — every pyproject.toml and all five blueprint.toml. (It would
# not touch the config/*.toml.example templates, which end in `.example`.)
/evaluations/**/arcagent.toml
/evaluations/**/arcllm.toml
/evaluations/**/arcrun.toml
# Repo-root guards. `ArcAgent(cfg)` without an absolute `config_path` resolves
# the workspace, trace dir, audit chain and capability scan root against the
# process CWD — which is this repo root. These catch that leak even if the
# harness makes the mistake. Anchoring is load-bearing: an unanchored
# `capabilities/` would hide packages/arcagent/src/arcagent/builtins/capabilities/.
/workspace/
/traces/
/.audit/
/capabilities/
/arcagent.toml
/arcllm.toml
/arcrun.toml

# Poolside
.poolside/

# Deployment — keep cloud-specific configs and credentials private.
# The public repo carries only the main agent framework; deploy paths
# (parameters.json with SSH keys / Object IDs / domain config) live
# in operator-controlled forks.
deploy/aws/
deploy/azure/
deploy/lib/



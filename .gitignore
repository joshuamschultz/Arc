# Private internal overlay repo (arc-internal) — separate git dir sharing
# this worktree. Its history must never be tracked by the public repo.
.git-internal/

# Work files
architecture/
**/architecture/
# ...but package architecture TEST suites are real tests (import-graph / DAG
# guards) and must be tracked — re-include them and their contents (ALL packages).
!packages/**/tests/architecture/
!packages/**/tests/architecture/**
# ...and so is the repo-root suite `make architecture-tests` actually runs
# (`pytest tests/architecture/`). Without this, a NEW guard added there is
# silently untracked and ruff skips the whole directory, so its lint errors
# never surface.
!/tests/architecture/
!/tests/architecture/**
# ...and docs/architecture/ is published documentation (ARCH-OVERVIEW, the
# policy-module catalogue, and the ADRs the doc set cross-references), not a
# work file. The glob above was swallowing it.
!docs/architecture/
!docs/architecture/**


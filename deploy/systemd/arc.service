[Unit]
Description=Arc — UI + embedded gateway (web chat, Telegram)
After=network-online.target

[Service]
# Two directories, and which is which is the whole design. ~/.arc is the
# INSTALL: everything executed here comes out of it, and it is disposable by
# construction. ~/arc is the OPERATOR's: the fleet, plus the source tarball
# beside it. Nothing is ever executed from ~/arc — a service that runs a
# checkout's venv has no disposable install, because the tree an update replaces
# and the tree a `git pull` rewrites are the same one.
#
# runtime/current is a SYMLINK to runtime/<version>, so an update is
# `arc runtime activate <new>` and a rollback is `arc runtime activate <old>`.
# Restarting the unit is what picks either up. Dropping a whole fresh ~/.arc in
# is also safe: no agent's memory, identity, tools, skills or workspace is
# under it.
WorkingDirectory=%h/.arc/runtime/current
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/arc/config/arc.env
# Modules are separately signed bundles that do not live in the wheel, so a
# freshly installed runtime otherwise brings the fleet back with ZERO modules —
# agents that boot, answer chat, and look healthy while their schedulers never
# fire. `arc install` re-materializes them into the active runtime and exits
# non-zero when it cannot, which fails the unit instead of serving a hollow
# agent. It also fails on a missing nats-server, so the Environment=PATH above
# must reach it — %h/.local/bin is where scripts/deploy-node.sh puts the binary.
ExecStartPre=%h/.arc/runtime/current/.venv/bin/arc install --team-root %h/arc/team
ExecStart=%h/.arc/runtime/current/.venv/bin/arc ui start --host 0.0.0.0 --port 8420 --team-root %h/arc/team --gateway-config %h/arc/config/gateway.toml --no-browser --viewer-token ${VIEWER_TOKEN} --operator-token ${OPERATOR_TOKEN}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

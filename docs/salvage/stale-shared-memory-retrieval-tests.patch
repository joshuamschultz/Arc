+@pytest.mark.asyncio
+async def test_default_shared_knowledge_is_composed_into_normal_memory_search_after_restart(
+    monkeypatch, tmp_path
+) -> None:
+    monkeypatch.setenv("ARC_TEAM_ROOT", str(tmp_path / "fleet"))
+    from arcmemory.adapters import FleetSharedKnowledgeBackend
+
+    FleetSharedKnowledgeBackend.for_arc_team().root.mkdir(parents=True)
+    publisher = AgentIdentity.generate("test", "shared-publisher")
+    _runtime.configure(
+        config={}, workspace=tmp_path / "publisher", agent_did=publisher.did, identity=publisher
+    )
+    saved = await knowledge_save("personal", "Release", "Use the shared release procedure.")
+    personal_identifier = saved.removesuffix(".").split()[-1]
+    await knowledge_promote(personal_identifier)
+
+    _runtime.reset()
+    reader = AgentIdentity.generate("test", "shared-reader")
+    _runtime.configure(
+        config={}, workspace=tmp_path / "reader", agent_did=reader.did, identity=reader
+    )
+    state = _runtime.state()
+    state.brain = _PersonalBrain()
+    state.active = True
+
+    recalled = await memory_search("release procedure")
+
+    assert "Personal recall." in recalled
+    assert "Use the shared release procedure." in recalled
+    assert 'source="shared:' in recalled
+
+    _runtime.reset()
+    _runtime.configure(
+        config={}, workspace=tmp_path / "reader", agent_did=reader.did, identity=reader
+    )
+    state = _runtime.state()
+    state.brain = _PersonalBrain()
+    state.active = True
+    assert "Use the shared release procedure." in await memory_search("release procedure")
+
+
+@pytest.mark.asyncio
+async def test_normal_memory_search_keeps_personal_recall_when_shared_storage_is_absent(
+    monkeypatch, tmp_path
+) -> None:
+    monkeypatch.setenv("ARC_TEAM_ROOT", str(tmp_path / "fleet"))
+    telemetry = _Telemetry()
+    identity = AgentIdentity.generate("test", "no-shared-store")
+    _runtime.configure(
+        config={},
+        telemetry=telemetry,
+        workspace=tmp_path / "agent",
+        agent_did=identity.did,
+        identity=identity,
+    )
+    state = _runtime.state()
+    state.brain = _PersonalBrain()
+    state.active = True
+
+    recalled = await memory_search("anything")
+
+    assert recalled == '<memory-result source="personal">Personal recall.</memory-result>'
+    assert any(event == "memory.shared_recall_degraded" for event, _ in telemetry.events)
